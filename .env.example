# BizStack Perks App Infrastructure Configuration (example)
# Do NOT store secrets in the repo. Provide these as environment variables on the host.

# Email sender used for onboarding and outreach
SENDER_EMAIL="you@yourdomain.com"

# Public URL where the platform will be hosted (used to generate webhook/redirect URLs)
PLATFORM_WEB_URL="https://your-domain.example.com"

# Database connection (defaults to sqlite file in repo root)
# Example SQLite: sqlite:///./bizstack.db
# Example Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL="sqlite:///./bizstack.db"

# Stripe keys (set these in the host environment; do NOT commit real keys here)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Optional telephony / email providers
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SENDGRID_API_KEY=""
