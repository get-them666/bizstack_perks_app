[Unit]
Description=BizStack Perks FastAPI Service
After=network.target

[Service]
User=www-data
WorkingDirectory=/srv/bizstack_perks_app
Environment=STRIPE_MODE=simulate
Environment=DATABASE_URL=sqlite:////srv/bizstack_perks_app/bizstack.db
Environment=ADMIN_TOKEN=change-me
ExecStart=/usr/bin/env python -m uvicorn api.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
