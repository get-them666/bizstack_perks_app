[Unit]
Description=BizStack Perks Streamlit Dashboard
After=network.target

[Service]
User=www-data
WorkingDirectory=/srv/bizstack_perks_app
Environment=PLATFORM_WEB_URL=http://localhost:8080
Environment=ADMIN_TOKEN=change-me
ExecStart=/usr/bin/env streamlit run dashboard.py --server.port 8501 --server.headless true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
